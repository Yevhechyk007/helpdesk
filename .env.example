# PostgreSQL
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=helpdesk_secret
POSTGRES_DB=helpdesk_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio_secret
MINIO_BUCKET_ATTACHMENTS=attachments
MINIO_BUCKET_IMPORTS=imports
MINIO_BUCKET_REPORTS=reports

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# API
API_PORT=3001
API_PREFIX=api
FRONTEND_URL=http://localhost:3000

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:3001/api
